&star_job  ! inlist_astero

      show_log_description_at_start = .false.
      warn_run_star_extras = .false. ! unused optional hooks use MESA defaults

      create_pre_main_sequence_model = .false.
      load_saved_model = .true.
      load_model_filename = 'start.mod'
      pre_ms_T_c = 9d5

      ! Save this independent continuation without altering its starting model.
      save_model_when_terminate = .true.
      save_model_filename = 'final.mod'

      change_initial_net = .false. ! preserve loaded nuclear reaction network
      new_net_name = 'o18_and_ne22.net'

      num_special_rate_factors = 1
      reaction_for_special_factor(1) = 'r_c12_ag_o16'
      special_rate_factor(1) = 1
      filename_of_special_rate(1) = 'c12ag_deboer_sigma_0p0_2000_Tgrid.dat'

      set_initial_cumulative_energy_error = .false.
      new_cumulative_energy_error = 0d0

      pgstar_flag = .false.


/ ! end of star_job namelist



&eos
/ ! end of eos namelist

&kap

      kap_file_prefix = 'gs98'
      kap_lowT_prefix = 'lowT_fa05_gs98'

      kap_blend_logT_upper_bdy = 4.1d0
      kap_blend_logT_lower_bdy = 4.0d0

      use_Type2_opacities = .false.

/ ! end of kap namelist


&colors

      ! Runtime synthetic photometry for the astero objective.
      use_colors = .true.

      ! Begin with the known-working Johnson filters. At 10 pc, the
      ! resulting B and V history columns are absolute magnitudes.
      instrument = 'data/colors_data/filters/Generic/Johnson'
      stellar_atm = 'data/colors_data/stellar_models/Kurucz2003all/'
      vega_sed = 'data/colors_data/stellar_models/vega_flam.csv'
      distance = 3.0857d19
      mag_system = 'Vega'

      ! A search evaluates many models and tracks; do not write an SED
      ! CSV for every evaluation. Magnitudes are still added to history.
      make_csv = .false.
      sed_per_model = .false.
      colors_results_directory = 'SED_alpha_cen_a'

/ ! end of colors namelist

&controls

      energy_eqn_option = 'dedt'
      use_gold2_tolerances = .true.

      num_trace_history_values = 2
      trace_history_value_name(1) = 'rel_E_err'
      trace_history_value_name(2) = 'log_rel_run_E_err'

      ! Fixed-parameter continuation with CAP18 and TP-AGB safety stops.
      max_model_number = -1
      max_age = 30d9
      Teff_lower_limit = 3600d0
      log_g_lower_limit = 0.1d0
      stop_at_phase_TP_AGB = .true.
      mixing_length_alpha = 1.8982421875d0
      initial_mass = 1.0788d0
      initial_y = 0.26d0
      do_element_diffusion = .false.
      varcontrol_target = 1d-3

      calculate_Brunt_N2 = .true.
      num_cells_for_smooth_brunt_B = 0

      atm_option = 'table'
      atm_table = 'photosphere'

      MLT_option = 'TDC'
      steps_before_use_TDC = 10

      ! timesteps
      max_years_for_timestep = 1d8

      ! mesh adjustment
      mesh_delta_coeff = 0.5

      ! controls for output
      ! Avoid writing hundreds of restart/profile files for every trial track.
      photo_interval = 50 ! retain restart checkpoints during long validation runs
      profile_interval = 1000000
      history_interval = 1
      terminal_interval = 10
      write_header_frequency = 10

/ ! end of controls namelist


&pgstar

      ! top level controls

         !pause_flag = .true.
            ! if true, the code waits for user to enter a RETURN on the command line


      ! make up a grid plot with echelle, TRho_Profile, Mode_Prop, logg_Teff
         Grid9_win_flag = .true.
         Grid9_win_width = 11
         Grid9_win_aspect_ratio = 0.7 ! aspect_ratio = height/width
